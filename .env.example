# Required — get from Google Cloud Console > APIs & Services > Credentials
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# Transport: "stdio" (default, for Claude Code/Desktop) or "http" (for remote/multi-client)
YOUTUBE_MCP_TRANSPORT=stdio

# HTTP transport settings (only used when YOUTUBE_MCP_TRANSPORT=http)
YOUTUBE_MCP_HTTP_PORT=3000
YOUTUBE_MCP_HTTP_HOST=127.0.0.1

# Quota: warn threshold (default 9000 of 10000 daily units)
YOUTUBE_MCP_QUOTA_LIMIT=9000

# Log level: error | warn | info | debug
YOUTUBE_MCP_LOG_LEVEL=info

# Node environment
NODE_ENV=production
